# Copy to .env and paste your token (never commit .env)
#
# Get CURSOR_SESSION_TOKEN:
#   1. Log into https://cursor.com
#   2. DevTools → Application → Cookies → cursor.com
#   3. Copy the value of WorkosCursorSessionToken
#
CURSOR_SESSION_TOKEN=

# Optional overrides
# PORT=8799
# USAGE_INTERVAL=600
